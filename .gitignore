# Python
__pycache__/
*.py[cod]
.venv/
venv/

# cocotb / simulation -- benches now live in tb/<name>/, each with its own
# sim_build, so these need to match one level deeper as well.
sim_build/
results.xml
*.fst
*.vcd

# Verilator
obj_dir/
*.log

# Generated results â€” regenerate with `python3 src/sweep.py`
results/

# Editor
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# ========================================
# Vivado & Xilinx Ignore Rules
# ========================================
*.jou
*.log
*.str
*.dmp
*.pb
.Xil/
dfx_runtime.txt
usage_statistics_webtalk.*

# Ignore GUI project directories and IP caches (if generated later)
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.gen/

# Vivado-generated project products inside the AXI/PYNQ integration project.
# Keep the hand-authored IP package, .xpr, .bd, .xci, and imported RTL.
axi_lite_wrapper/**/dlzs.gen/
axi_lite_wrapper/**/dlzs.runs/
axi_lite_wrapper/**/dlzs.cache/
axi_lite_wrapper/**/dlzs.hw/
axi_lite_wrapper/**/dlzs.sim/
axi_lite_wrapper/**/dlzs.ip_user_files/
axi_lite_wrapper/**/ipshared/
axi_lite_wrapper/**/xsim.dir/
axi_lite_wrapper/**/waveform/
axi_lite_wrapper/**/ui/
axi_lite_wrapper/ip_repo/edit_dlzs_axi_v1_0.srcs/
axi_lite_wrapper/ip_repo/edit_dlzs_axi_v1_0.xpr
axi_lite_wrapper/ip_repo/tb_axi_smoke_behav.wcfg
axi_lite_wrapper/**/*.bda

# Board definitions are local Vivado setup files, not project sources.
/board_files/

# XSim simulation files (if you use XSim instead of Icarus)
xsim.dir/
xsim.jou
xsim.log
xvlog.pb
xvhdl.pb
xelab.pb

# ========================================
# EXPLICIT KEEP RULES
# ========================================
# Do not ignore the Vivado Out-of-Context synthesis reports!
!synth_result/
!synth_result/*

# Routed checkpoints written by synth_ooc.tcl for synth/power.tcl. Build
# products, ~1 MB each, regenerated with -force -- not committed. (Placed after
# the synth_result keep rules on purpose: last match wins.)
*.dcp

# Generated scratch files and Vivado clock-routing diagnostics
/work/
/clockInfo.txt

# Intermediate schematic exports; retain final SVGs and PNGs
/docs/images/vivado/elaborated/*.pdf

# Curated simulation evidence may be committed despite the global *.log rule
!/evidence/logs/
!/evidence/logs/*.log
