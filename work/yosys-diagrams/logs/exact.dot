digraph "exact" {
label="exact";
rankdir="LR";
remincross=true;
n1 [ shape=octagon, label="mul_out", color="black", fontcolor="black" ];
n2 [ shape=octagon, label="operand1", color="black", fontcolor="black" ];
n3 [ shape=octagon, label="operand2", color="black", fontcolor="black" ];
c7 [ shape=record, label="{{<p4> A|<p5> B}|$1\n$mul|{<p6> Y}}",  ];
x0 [ shape=record, style=rounded, label="<s16> 16x 15:15 - 31:16 |<s0> 15:0 - 15:0 ", color="black", fontcolor="black" ];
x0:e -> c7:p4:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", fontcolor="black", style="setlinewidth(3)", label=""];
x1 [ shape=record, style=rounded, label="<s16> 16x 15:15 - 31:16 |<s0> 15:0 - 15:0 ", color="black", fontcolor="black" ];
x1:e -> c7:p5:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c7:p6:e -> n1:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n2:e -> x0:s0:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n2:e -> x0:s16:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n3:e -> x1:s0:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n3:e -> x1:s16:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
}
