# cocotb makefile for the DRUM baseline testbench.
#
#   make -f Makefile.drum                     run everything with Icarus
#   make -f Makefile.drum lint                Verilator lint only
#   make -f Makefile.drum DRUM_N_RANDOM=1000  short smoke run
#   make -f Makefile.drum clean
#
# Kept separate from the DLZS makefile rather than merged behind a variable:
# cocotb drives one TOPLEVEL per invocation, and a shared makefile would put
# the choice of DUT in an environment variable where it is easy to run the
# wrong one and believe the pass.

TOPDIR   := $(shell dirname $(realpath $(firstword $(MAKEFILE_LIST))))
DRUMDIR  := $(TOPDIR)/../baselines/drum

SIM            ?= icarus
TOPLEVEL_LANG  ?= verilog
TOPLEVEL       := drum_tb_top
COCOTB_TEST_MODULES := test_drum

# Icarus needs -g2012 for the SystemVerilog generate/parameter syntax in
# drum_signed_top. The vendored DRUM cores are plain Verilog-2001 and compile
# under it unchanged.
COMPILE_ARGS += -g2012

VERILOG_SOURCES := $(DRUMDIR)/DRUM6_16_u.v $(DRUMDIR)/DRUM4_16_u.v \
                   $(DRUMDIR)/drum_signed_top.sv \
                   $(TOPDIR)/drum_tb_top.sv

# Must have a value before export: `export FOO` on an unset variable passes an
# empty string to the environment, not an absent key, so the testbench's
# os.environ.get() default would never fire.
DRUM_N_RANDOM ?= 200000
export DRUM_N_RANDOM

# Fail with a readable message rather than collapsing to /Makefile.sim when
# cocotb-config is off PATH, which is what an unactivated venv looks like.
COCOTB_MAKEFILES := $(shell cocotb-config --makefiles 2>/dev/null)
ifeq ($(COCOTB_MAKEFILES),)
    $(error cocotb not found — activate the venv, or pip install cocotb)
endif

include $(COCOTB_MAKEFILES)/Makefile.sim

lint:
	verilator --lint-only -Wall -Wno-DECLFILENAME $(VERILOG_SOURCES)

clean::
	rm -rf $(TOPDIR)/sim_build $(TOPDIR)/__pycache__ $(TOPDIR)/results.xml

.PHONY: lint clean
